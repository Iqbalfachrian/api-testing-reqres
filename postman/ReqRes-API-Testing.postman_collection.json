        {
          "name": "Create user - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Iqbal QA\",\n  \"job\": \"Automation QA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Positive create scenario. The legacy endpoint returns the submitted fields plus id and createdAt."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response time is below the configured limit\", function () {",
                  "    const limit = Number(pm.environment.get(\"max_response_time_ms\") || 2000);",
                  "    pm.expect(pm.response.responseTime).to.be.below(limit);",
                  "});",
                  "pm.test(\"Created response contains submitted data and metadata\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.name).to.eql(\"Iqbal QA\");",
                  "    pm.expect(json.job).to.eql(\"Automation QA\");",
                  "    pm.expect(json.id).to.exist;",
                  "    pm.expect(json.createdAt).to.be.a(\"string\");",
                  "    pm.environment.set(\"created_user_id\", String(json.id));",
                  "});"
                ]
              }
            }
          ]
        },
