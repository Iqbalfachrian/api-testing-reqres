{
  "info": {
    "_postman_id": "1d0d0c6e-9d57-4f61-8a5a-3c0b1f4d7e21",
    "name": "ReqRes - API Testing Sample",
    "description": "Portfolio sample for Iqbal: functional REST API checks against ReqRes legacy endpoints. Set the ReqRes environment before running the collection.\n\nCurrent ReqRes documentation requires an x-api-key header for API requests. No real key is stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Keep this collection safe to share: credentials stay in the environment, not in the collection."
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Users and CRUD",
      "item": [
        {
          "name": "List users - 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            },
            "description": "Positive list-users scenario with pagination."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is below the configured limit\", function () {",
                  "    const limit = Number(pm.environment.get(\"max_response_time_ms\") || 2000);",
                  "    pm.expect(pm.response.responseTime).to.be.below(limit);",
                  "});",
                  "pm.test(\"Response contains a non-empty user list\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(json.page).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get single user - 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Positive detail scenario for a known demo user."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is below the configured limit\", function () {",
                  "    const limit = Number(pm.environment.get(\"max_response_time_ms\") || 2000);",
                  "    pm.expect(pm.response.responseTime).to.be.below(limit);",
                  "});",
                  "pm.test(\"Response contains the requested user id\", function () {",
                  "    const json = pm.response.json();",
                  "    const expectedId = Number(pm.environment.get(\"user_id\") || 2);",
                  "    pm.expect(json.data).to.be.an(\"object\");",
                  "    pm.expect(json.data.id).to.eql(expectedId);",
                  "});"
                ]
              }
            }
          ]
        },
